{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bobiverse wormhole gates — travel topology (not the Euclidean chart, not SCUT)",
  "type": "object",
  "required": ["nodes", "paths", "summaries"],
  "properties": {
    "_comment": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "layer", "cite", "note", "spoil"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["hub", "system", "place", "faction_home"]
          },
          "layer": {
            "type": "string",
            "enum": ["found", "constructed"],
            "description": "found = alien mesh; constructed = Bob-built / Skippy-adjacent termini."
          },
          "system": {
            "type": "string",
            "description": "systems.json id when this terminus is a real survey star (Chart link only if that system has xyz_ly)."
          },
          "at": {
            "type": "string",
            "description": "Parent gates node id — e.g. a planet at a hub, not a separate Hipparcos system."
          },
          "role": { "type": "string", "maxLength": 72 },
          "cite": { "type": "string" },
          "note": { "type": "string" },
          "spoil": { "type": "integer", "minimum": 1 },
          "also": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Related peoples or bobs ids."
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ends", "kind", "cite", "note", "spoil"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "ends": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string" }
          },
          "kind": {
            "type": "string",
            "enum": ["found", "constructed", "planned"]
          },
          "status": {
            "type": "string",
            "enum": ["surveyed", "planned", "building", "open"]
          },
          "hop_count": { "type": "integer", "minimum": 1 },
          "intermediate_count": { "type": "integer", "minimum": 0 },
          "ferry_ly_total": {
            "type": "number",
            "description": "Sum of STL endpoint-haul legs when the books give it. Never used to place found edges."
          },
          "span_ly": {
            "type": "number",
            "description": "Straight-line distance between termini when cited (e.g. EE–Skippyland ~70 ly). Not a hop length."
          },
          "role": { "type": "string", "maxLength": 72 },
          "cite": { "type": "string" },
          "note": { "type": "string" },
          "spoil": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "cite", "note", "spoil"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "role": { "type": "string", "maxLength": 72 },
          "cite": { "type": "string" },
          "note": { "type": "string" },
          "spoil": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
